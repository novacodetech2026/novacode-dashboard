# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Client-side Public Variables)
# Configure these in your environment or via the in-app Supabase Connection panel.
# Use your project's Base URL only (no /auth/v1 or extra paths) and Public Anon Key (NEVER expose service_role in frontend).
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# CLOUDFLARE TURNSTILE FOR PUBLIC SMS CONSENT FORM (Public Site Key ONLY)
# Never put TURNSTILE_SECRET_KEY in any VITE_ variable or frontend file; set TURNSTILE_SECRET_KEY strictly as a Supabase Edge Function secret.
VITE_TURNSTILE_SITE_KEY=""

# PUBLIC LEGAL CONTACT EMAIL FOR PRIVACY POLICY & TERMS OF SERVICE
# Public contact email displayed on /privacy-policy and /terms-of-service for Novacode Tech LLC.
VITE_PUBLIC_CONTACT_EMAIL="info@novacodetech.com"
